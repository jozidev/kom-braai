# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# App URL (used for copy-link and absolute URLs; set to your Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (email notifications) — get your API key at resend.com
RESEND_API_KEY=re_your_api_key
# Optional: override the from address (defaults to noreply@kombraai.app)
# RESEND_FROM_EMAIL=Kom Braai <noreply@kombraai.app>
