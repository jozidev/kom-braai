# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# App URL (used for copy-link and absolute URLs; set to your Vercel domain in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
